  "javascript": "// Interception et envoi du formulaire final\ndocument.getElementById('form-etape-3').addEventListener('submit', async function(e) {\n    e.preventDefault();\n\n    const btn = document.getElementById('btn-soumettre');\n    btn.innerText = \"Téléversement des pièces...\";\n    btn.disabled = true;\n\n    try {\n        // 1. Téléversements séquentiels vers Frappe\n        const urlDiploma = await uploadFichierFrappe('access_diploma_copy');\n        const urlBirth = await uploadFichierFrappe('birth_certificate');\n        const urlPhoto = await uploadFichierFrappe('passport_photo');\n        const urlMotivation = await uploadFichierFrappe('motivation_letter');\n        const urlCV = await uploadFichierFrappe('cv');\n        const urlReceipt = await uploadFichierFrappe('remittance_receipt');\n\n        if (!urlDiploma || !urlBirth || !urlPhoto || !urlReceipt) {\n            throw new Error('pièces obligatoires manquantes');\n        }\n\n        btn.innerText = \"Traitement final...\";\n\n        // 2. Compilation des données locales (noms de champs du doctype)\n        const payload = {\n            doctype: \"Session Inscription Candidate\",\n            last_name: localStorage.getItem('last_name') || '',\n            first_name: localStorage.getItem('first_name') || '',\n            email: localStorage.getItem('email') || '',\n            phone: localStorage.getItem('phone') || '',\n            birthdate: localStorage.getItem('date_of_birth') || '',\n            birth_place: localStorage.getItem('place_of_birth') || '',\n            sexe: localStorage.getItem('sexe') || '',\n            niveau: localStorage.getItem('niveau') || '',\n            examination_centre: localStorage.getItem('examination_centre') || '',\n            access_diploma_copy: urlDiploma,\n            birth_certificate: urlBirth,\n            id_photo: urlPhoto,\n            remittance_receipt: urlReceipt\n        };\n\n        // 3. Envoi à la base de données Frappe\n        const response = await fetch('/api/resource/Session Inscription Candidate', {\n            method: 'POST',\n            headers: {\n                'Accept': 'application/json',\n                'Content-Type': 'application/json',\n                'X-Frappe-CSRF-Token': frappe.csrf_token\n            },\n            body: JSON.stringify(payload)\n        });\n\n        const result = await response.json();\n\n        // 4. Redirection forcée\n        if (result.data) {\n            localStorage.clear(); // Vider les caches locaux\n\n            // Construit proprement l'adresse finale\n            const targetUrl = \"/success-candidature?name=\" + encodeURIComponent(result.data.name) +\n                              \"&email=\" + encodeURIComponent(payload.email) +\n                              \"&filiere=\" + encodeURIComponent(payload.niveau) +\n                              \"&niveau=\" + encodeURIComponent(payload.niveau);\n\n            window.location.href = targetUrl;\n        } else {\n            alert(\"Erreur lors de la sauvegarde dans la base de données.\");\n            btn.innerText = \"Soumettre ma candidature\";\n            btn.disabled = false;\n        }\n    } catch (err) {\n        console.error(err);\n        alert(\"Une erreur technique s'est produite lors du transfert.\");\n        btn.innerText = \"Soumettre ma candidature\";\n        btn.disabled = false;\n    }\n});\n",
