  "main_section_html": "<div class=\"main-wrapper\">\n  <!-- Fil d'Ariane entièrement NOIR -->\n  <div class=\"step-header\">\n    <div class=\"step-item\">\n      <span class=\"step-number\">\n        <svg xmlns=\"http://w3.org\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n      </span> \n      Informations personnelles\n    </div>\n    <div class=\"step-line\"></div>\n    <div class=\"step-item\">\n      <span class=\"step-number\">\n        <svg xmlns=\"http://w3.org\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n      </span> \n      Candidature\n    </div>\n    <div class=\"step-line\"></div>\n    <div class=\"step-item\"><span class=\"step-number\">3</span> Documents</div>\n  </div>\n\n  <!-- Formulaire Card -->\n  <div class=\"form-card\">\n    <h3 class=\"fw-bold mb-1\" style=\"color: #1e2025; font-size: 22px; text-align: left;\">Pièces justificatives</h3>\n    <p class=\"text-muted mb-4 small\" style=\"text-align: left;\">Formats acceptés : PDF, JPG, PNG · Max 5 Mo par fichier</p>\n\n    <form id=\"form-etape-3\" class=\"d-flex flex-column\" style=\"gap: 16px;\">\n      \n      <!-- 1. Relevé de notes -->\n      <div class=\"p-3 rounded-4 d-flex align-items-center justify-content-between position-relative\" style=\"background: #f5f6f8; border: 1px solid #e2e4e9; min-height: 72px;\">\n        <div class=\"d-flex align-items-center\" style=\"gap: 16px; text-align: left;\">\n          <div class=\"d-flex align-items-center justify-content-center rounded-3 bg-white border\" style=\"width: 40px; height: 40px; color: #6b6d7a; shrink-0;\">\n            <svg xmlns=\"http://w3.org\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/></svg>\n          </div>\n          <div>\n            <h6 class=\"fw-semibold mb-0\" style=\"color: #1e2025; font-size: 14px;\">Relevé de notes (Bac / dernières années) *</h6>\n            <span id=\"txt-diploma\" class=\"text-muted small\" style=\"font-size: 12px;\">Cliquez pour joindre le fichier</span>\n          </div>\n        </div>\n        <span class=\"text-muted small fw-medium px-3 shrink-0\" style=\"font-size: 13px;\">Joindre</span>\n        <input type=\"file\" id=\"access_diploma_copy\" class=\"input-file-hidden\" required accept=\"image/*,.pdf\">\n      </div>\n\n      <!-- 2. Acte de naissance -->\n      <div class=\"p-3 rounded-4 d-flex align-items-center justify-content-between position-relative\" style=\"background: #f5f6f8; border: 1px solid #e2e4e9; min-height: 72px;\">\n        <div class=\"d-flex align-items-center\" style=\"gap: 16px; text-align: left;\">\n          <div class=\"d-flex align-items-center justify-content-center rounded-3 bg-white border\" style=\"width: 40px; height: 40px; color: #6b6d7a; shrink-0;\">\n            <svg xmlns=\"http://w3.org\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/></svg>\n          </div>\n          <div>\n            <h6 class=\"fw-semibold mb-0\" style=\"color: #1e2025; font-size: 14px;\">Acte de naissance *</h6>\n            <span id=\"txt-birth\" class=\"text-muted small\" style=\"font-size: 12px;\">Cliquez pour joindre le fichier</span>\n          </div>\n        </div>\n        <span class=\"text-muted small fw-medium px-3 shrink-0\" style=\"font-size: 13px;\">Joindre</span>\n        <input type=\"file\" id=\"birth_certificate\" class=\"input-file-hidden\" required accept=\"image/*,.pdf\">\n      </div>\n\n      <!-- 3. Photo d'identité -->\n      <div class=\"p-3 rounded-4 d-flex align-items-center justify-content-between position-relative\" style=\"background: #f5f6f8; border: 1px solid #e2e4e9; min-height: 72px;\">\n        <div class=\"d-flex align-items-center\" style=\"gap: 16px; text-align: left;\">\n          <div class=\"d-flex align-items-center justify-content-center rounded-3 bg-white border\" style=\"width: 40px; height: 40px; color: #6b6d7a; shrink-0;\">\n            <svg xmlns=\"http://w3.org\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/></svg>\n          </div>\n          <div>\n            <h6 class=\"fw-semibold mb-0\" style=\"color: #1e2025; font-size: 14px;\">Photo d'identité (format passeport) *</h6>\n            <span id=\"txt-photo\" class=\"text-muted small\" style=\"font-size: 12px;\">Cliquez pour joindre le fichier</span>\n          </div>\n        </div>\n        <span class=\"text-muted small fw-medium px-3 shrink-0\" style=\"font-size: 13px;\">Joindre</span>\n        <input type=\"file\" id=\"passport_photo\" class=\"input-file-hidden\" required accept=\"image/*\">\n      </div>\n\n      <!-- 4. Lettre de motivation -->\n      <div class=\"p-3 rounded-4 d-flex align-items-center justify-content-between position-relative\" style=\"background: #f5f6f8; border: 1px solid #e2e4e9; min-height: 72px;\">\n        <div class=\"d-flex align-items-center\" style=\"gap: 16px; text-align: left;\">\n          <div class=\"d-flex align-items-center justify-content-center rounded-3 bg-white border\" style=\"width: 40px; height: 40px; color: #6b6d7a; shrink-0;\">\n            <svg xmlns=\"http://w3.org\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/></svg>\n          </div>\n          <div>\n            <h6 class=\"fw-semibold mb-0\" style=\"color: #1e2025; font-size: 14px;\">Lettre de motivation</h6>\n            <span id=\"txt-motivation\" class=\"text-muted small\" style=\"font-size: 12px;\">Cliquez pour joindre le fichier</span>\n          </div>\n        </div>\n        <span class=\"text-muted small fw-medium px-3 shrink-0\" style=\"font-size: 13px;\">Joindre</span>\n        <input type=\"file\" id=\"motivation_letter\" class=\"input-file-hidden\" accept=\"image/*,.pdf\">\n      </div>\n\n      <!-- 5. Curriculum Vitae -->\n      <div class=\"p-3 rounded-4 d-flex align-items-center justify-content-between position-relative\" style=\"background: #f5f6f8; border: 1px solid #e2e4e9; min-height: 72px;\">\n        <div class=\"d-flex align-items-center\" style=\"gap: 16px; text-align: left;\">\n          <div class=\"d-flex align-items-center justify-content-center rounded-3 bg-white border\" style=\"width: 40px; height: 40px; color: #6b6d7a; shrink-0;\">\n            <svg xmlns=\"http://w3.org\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/></svg>\n          </div>\n          <div>\n            <h6 class=\"fw-semibold mb-0\" style=\"color: #1e2025; font-size: 14px;\">Curriculum Vitae <span class=\"text-muted fw-normal\" style=\"font-size: 12px;\">optionnel</span></h6>\n            <span id=\"txt-cv\" class=\"text-muted small\" style=\"font-size: 12px;\">Cliquez pour joindre le fichier</span>\n          </div>\n        </div>\n        <span class=\"text-muted small fw-medium px-3 shrink-0\" style=\"font-size: 13px;\">Joindre</span>\n        <input type=\"file\" id=\"cv\" class=\"input-file-hidden\" accept=\"image/*,.pdf\">\n      </div>\n\n      <!-- 6. Reçu de versement -->\n      <div class=\"p-3 rounded-4 d-flex align-items-center justify-content-between position-relative\" style=\"background: #f5f6f8; border: 1px solid #e2e4e9; min-height: 72px;\">\n        <div class=\"d-flex align-items-center\" style=\"gap: 16px; text-align: left;\">\n          <div class=\"d-flex align-items-center justify-content-center rounded-3 bg-white border\" style=\"width: 40px; height: 40px; color: #6b6d7a; shrink-0;\">\n            <svg xmlns=\"http://w3.org\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/></svg>\n          </div>\n          <div>\n            <h6 class=\"fw-semibold mb-0\" style=\"color: #1e2025; font-size: 14px;\">Reçu de versement *</h6>\n            <span id=\"txt-receipt\" class=\"text-muted small\" style=\"font-size: 12px;\">Cliquez pour joindre le fichier</span>\n          </div>\n        </div>\n        <span class=\"text-muted small fw-medium px-3 shrink-0\" style=\"font-size: 13px;\">Joindre</span>\n        <input type=\"file\" id=\"remittance_receipt\" class=\"input-file-hidden\" required accept=\"image/*,.pdf\">\n      </div>\n\n      <!-- Barre de navigation -->\n      <div class=\"navigation-bar mt-5\">\n        <!-- Bouton Précédent configuré vers la route: information-candidat -->\n        <a href=\"/information-candidat\" class=\"btn btn-prev d-inline-flex align-items-center\" style=\"gap: 6px;\">\n          <svg class=\"frappe-icon\" style=\"stroke: currentColor; fill: none; width: 14px; height: 14px;\"><use href=\"#icon-arrow-left\"></use></svg> Précédent\n        </a>\n        <button type=\"submit\" id=\"btn-soumettre\" class=\"btn btn-next d-inline-flex align-items-center\" style=\"gap: 10px;\">\n          <svg xmlns=\"http://w3.org\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"transform: rotate(-15deg);\"><line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"/><polygon points=\"22 2 15 22 11 13 2 9 22 2\"/></svg>\n          Soumettre ma candidature\n        </button>\n      </div>\n\n    </form>\n  </div>\n</div>\n\n<script>\n  // Script d'affichage des noms de fichiers\n  const itemsMapping = [\n      { id: 'access_diploma_copy', txt: 'txt-diploma' },\n      { id: 'birth_certificate', txt: 'txt-birth' },\n      { id: 'passport_photo', txt: 'txt-photo' },\n      { id: 'motivation_letter', txt: 'txt-motivation' },\n      { id: 'cv', txt: 'txt-cv' },\n      { id: 'remittance_receipt', txt: 'txt-receipt' }\n  ];\n\n  itemsMapping.forEach(item => {\n      document.getElementById(item.id).addEventListener('change', function() {\n          if (this.files.length > 0) {\n              document.getElementById(item.txt).innerText = this.files[0].name;\n              document.getElementById(item.txt).style.color = \"#2c2d30\";\n              document.getElementById(item.txt).style.fontWeight = \"600\";\n          }\n      });\n  });\n\n  async function uploadFichierFrappe(idInput) {\n      const input = document.getElementById(idInput);\n      if (!input || input.files.length === 0) return null;\n\n      const formData = new FormData();\n      formData.append('file', input.files[0]);\n      formData.append('is_private', 1);\n      formData.append('folder', 'Home/Attachments');\n      formData.append('doctype', 'Session Inscription Candidate');\n\n      const res = await fetch('/api/method/upload_file', {\n          method: 'POST',\n          headers: { 'X-Frappe-CSRF-Token': frappe.csrf_token },\n          body: formData\n      });\n\n      const d = await res.json();\n      if (d && d.message && typeof d.message === 'object' && d.message.file_url) {\n          return d.message.file_url;\n      }\n      return null;\n  }\n</script>\n",
