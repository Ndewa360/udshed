  "main_section_html": "<div class=\"d-flex flex-column align-items-center justify-content-center min-vh-100 py-5 px-3\" style=\"background: #f0f1f3; font-family: sans-serif;\">\n  \n  <div class=\"w-100 text-center\" style=\"max-width: 600px;\">\n    \n    <!-- Icône enveloppe / succès native Frappe -->\n    <div class=\"d-inline-flex align-items-center justify-content-center rounded-circle mb-4\" style=\"width: 56px; height: 56px; background: #ffffff; border: 1px solid #e2e4e9;\">\n      <svg class=\"frappe-icon\" style=\"stroke: #1e2025; fill: none; width: 24px; height: 24px;\">\n          <use href=\"#icon-mail\"></use>\n      </svg>\n    </div>\n\n    <!-- Titre principal -->\n    <h2 class=\"fw-semibold mb-3\" style=\"color: #1e2025; font-size: 28px; letter-spacing: -0.02em;\">Candidature soumise avec succès</h2>\n    \n    <!-- Message de confirmation -->\n    <p class=\"mb-5 mx-auto text-muted\" style=\"font-size: 15px; line-height: 1.6; max-width: 520px;\">\n      Votre dossier a bien été reçu. Un email de confirmation a été envoyé à \n      <b id=\"candidat-email\" style=\"color: #1e2025;\">votre email</b>. \n      Conservez précieusement votre numéro de dossier pour suivre l'état de votre candidature.\n    </p>\n\n    <!-- BLOC CENTRAL : Numéro de dossier -->\n    <div class=\"bg-white p-4 rounded-4 mb-4 border shadow-sm mx-auto\" style=\"max-width: 440px; border-color: #e2e4e9;\">\n      <span class=\"d-block text-muted fw-medium mb-2\" style=\"font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;\">Votre numéro de dossier</span>\n      \n      <!-- Numéro dynamique -->\n      <h1 id=\"numero-dossier\" class=\"fw-bold mb-2\" style=\"color: #1e2025; font-size: 32px; letter-spacing: 1px;\">CAND-2026-9747</h1>\n      \n      <!-- Métadonnées de la filière -->\n      <span id=\"meta-filiere\" class=\"text-muted\" style=\"font-size: 13px;\">Filière : Informatique & Réseaux · Niveau : Licence 1</span>\n    </div>\n\n    <!-- BLOC INFÉRIEUR : Prochaines étapes -->\n    <div class=\"bg-white p-4 rounded-4 text-start border shadow-sm mx-auto mb-4\" style=\"max-width: 520px; border-color: #e2e4e9;\">\n      <h6 class=\"fw-semibold text-muted mb-4\" style=\"font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase;\">Prochaines étapes</h6>\n      \n      <!-- Étape 1 -->\n      <div class=\"d-flex align-items-start mb-3\" style=\"gap: 14px;\">\n        <div class=\"d-flex align-items-center justify-content-center rounded-circle fw-semibold shrink-0\" style=\"width: 24px; height: 24px; background: #f5f6f8; color: #525462; font-size: 11px;\">1</div>\n        <p class=\"text-muted mb-0\" style=\"font-size: 13px; line-height: 1.5;\">Votre dossier est en cours d'examen par le gestionnaire des inscriptions.</p>\n      </div>\n\n      <!-- Étape 2 -->\n      <div class=\"d-flex align-items-start mb-3\" style=\"gap: 14px;\">\n        <div class=\"d-flex align-items-center justify-content-center rounded-circle fw-semibold shrink-0\" style=\"width: 24px; height: 24px; background: #f5f6f8; color: #525462; font-size: 11px;\">2</div>\n        <p class=\"text-muted mb-0\" style=\"font-size: 13px; line-height: 1.5;\">Vous serez notifié par email de toute décision concernant votre candidature.</p>\n      </div>\n\n      <!-- Étape 3 -->\n      <div class=\"d-flex align-items-start\" style=\"gap: 14px;\">\n        <div class=\"d-flex align-items-center justify-content-center rounded-circle fw-semibold shrink-0\" style=\"width: 24px; height: 24px; background: #f5f6f8; color: #525462; font-size: 11px;\">3</div>\n        <p class=\"text-muted mb-0\" style=\"font-size: 13px; line-height: 1.5;\">En cas de validation, vous serez automatiquement inscrit dans votre filière.</p>\n      </div>\n    </div>\n\n    <!-- Bouton de retour optionnel pour le confort utilisateur -->\n    <a href=\"/index\" class=\"btn btn-sm text-muted mt-3\" style=\"font-size: 13px; text-decoration: underline;\">Retour à la page d'accueil</a>\n\n  </div>\n</div>\n\n<script>\n  // Extraction des variables dynamiques depuis l'URL de redirection passée par Frappe\n  document.addEventListener(\"DOMContentLoaded\", function() {\n      const urlParams = new URLSearchParams(window.location.search);\n      \n      const docName = urlParams.get('name');\n      const email = urlParams.get('email');\n      const filiere = urlParams.get('filiere');\n      const niveau = urlParams.get('niveau');\n\n      if (docName) document.getElementById('numero-dossier').innerText = docName;\n      if (email) document.getElementById('candidat-email').innerText = email;\n      \n      if (filiere && niveau) {\n          document.getElementById('meta-filiere').innerText = `Filière : ${filiere} · Niveau : ${niveau}`;\n      }\n  });\n</script>\n",
