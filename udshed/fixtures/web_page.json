  "main_section_html": "<div class=\"main-wrapper\">\n  <div class=\"step-header\">\n    <div class=\"step-item active\"><span class=\"step-number\">1</span> Candidature</div>\n    <div class=\"step-line\"></div>\n    <div class=\"step-item\"><span class=\"step-number\">2</span> Informations personnelles</div>\n    <div class=\"step-line\"></div>\n    <div class=\"step-item\"><span class=\"step-number\">3</span> Documents</div>\n  </div>\n\n  <div class=\"form-card\">\n    <h3 class=\"fw-bold mb-1\" style=\"color: #1e2025; font-size: 22px; text-align: left;\">Choix du candidat</h3>\n    <p class=\"text-muted mb-4 small\" style=\"text-align: left;\">Ces informations seront utilisées pour orienter votre dossier académique.</p>\n\n    <form id=\"form-etape-1\" class=\"row g-4\">\n      \n      <!-- Ligne 4 du DocType : niveau -->\n      <div class=\"col-12 col-md-6\" style=\"text-align: left;\">\n        <label class=\"form-label small fw-semibold\" style=\"color: #525462;\">Niveau d'admission *</label>\n        <select id=\"niveau\" class=\"form-select custom-select\" required>\n          <option value=\"\">Sélectionner le niveau...</option>\n          <option value=\"BTS\">BTS 1</option>\n          <option value=\"BTS\">BTS 2</option>\n          <option value=\"LICENCE 1\">LICENCE 1</option>\n          <option value=\"LICENCE\">LICENCE 2</option>\n          <option value=\"LICENCE\">LICENCE 3</option>\n           <option value=\"MASTER\">MASTER 1</option>\n            <option value=\"MASTER\">MASTER 2</option>\n        </select>\n      </div>\n\n      <!-- Ligne 5 du DocType : examination_centre -->\n      <div class=\"col-12 col-md-6\" style=\"text-align: left;\">\n        <label class=\"form-label small fw-semibold\" style=\"color: #525462;\">Centre choisi pour concours *</label>\n        <select id=\"examination_centre\" class=\"form-select custom-select\" required>\n          <option value=\"\">Sélectionner le centre...</option>\n          <option value=\"Bangangté\">Bangangté</option>\n          <option value=\"Bafoussam\">Bafoussam</option>\n          <option value=\"Yaoundé\">Yaoundé</option>\n          <option value=\"Douala\">Douala</option>\n        </select>\n      </div>\n\n      <div class=\"col-12 d-flex justify-content-end mt-5\">\n        <button type=\"submit\" class=\"btn btn-next d-inline-flex align-items-center\" style=\"gap: 8px;\">\n          Continuer <svg class=\"frappe-icon\" style=\"stroke: #ffffff; fill: none; width: 14px; height: 14px;\"><use href=\"#icon-arrow-right\"></use></svg>\n        </button>\n      </div>\n    </form>\n  </div>\n</div>\n\n<script>\n  // 1. GESTION DU BLOCAGE VISUEL : Forcer le texte sélectionné à s'afficher en noir foncé\n  function forcerCouleurOption() {\n      const selects = document.querySelectorAll('.custom-select');\n      selects.forEach(select => {\n          // Si une option est choisie ou rechargée, on applique le noir\n          if (select.value !== \"\") {\n              select.style.setProperty('color', '#1e2025', 'important');\n          }\n          // On écoute le changement pour écraser le style transparent de Frappe v16\n          select.addEventListener('change', function() {\n              this.style.setProperty('color', '#1e2025', 'important');\n          });\n      });\n  }\n\n  // Activer le correctif dès le chargement de l'interface\n  document.addEventListener(\"DOMContentLoaded\", forcerCouleurOption);\n  window.addEventListener(\"load\", forcerCouleurOption);\n\n  // 2. SOUBOUMISSION ET ROUTAGE NATIF\n  document.getElementById('form-etape-1').addEventListener('submit', function(e) {\n      e.preventDefault();\n      \n      localStorage.setItem('niveau', document.getElementById('niveau').value);\n      localStorage.setItem('examination_centre', document.getElementById('examination_centre').value);\n      \n      window.location.href = '/information-candidat';\n  });\n</script>",
