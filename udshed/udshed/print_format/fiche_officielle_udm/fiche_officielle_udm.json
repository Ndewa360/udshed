 "html": "<style>\n    @page {\n        size: A4;\n        margin: 12mm 12mm 16mm 12mm;\n    }\n\n    body {\n        font-family: \"Times New Roman\", Times, serif;\n        color: #000;\n        font-size: 12px;\n        margin: 0;\n        padding: 0;\n    }\n\n    .page {\n        width: 210mm;\n        min-height: 272mm;\n        margin: 0 auto;\n        position: relative;\n        page-break-after: always;\n    }\n\n    .page:last-child {\n        page-break-after: auto;\n    }\n\n    /* ============ EN-TÊTE ============ */\n    .header {\n        text-align: center;\n        margin-bottom: 8px;\n    }\n\n    .header img.logo {\n        max-height: 62px;\n        margin-bottom: 6px;\n    }\n\n    .university {\n        font-size: 17px;\n        font-weight: bold;\n        text-transform: uppercase;\n    }\n\n    .institute {\n        font-size: 14px;\n        font-weight: bold;\n        margin-top: 2px;\n    }\n\n    .department {\n        font-size: 13px;\n        margin-top: 2px;\n    }\n\n    .year {\n        font-size: 13px;\n        margin-top: 2px;\n    }\n\n    .header-title {\n        font-size: 15px;\n        font-weight: bold;\n        margin-top: 10px;\n        text-transform: uppercase;\n    }\n\n    .header-subtitle {\n        font-size: 12px;\n        margin-top: 2px;\n        font-style: italic;\n    }\n\n    .student-info {\n        display: flex;\n        justify-content: space-between;\n        margin: 10px 0 4px 0;\n        font-size: 13px;\n        font-weight: bold;\n    }\n\n    /* ============ SECTIONS ============ */\n    .section-title {\n        background: #e5e5e5;\n        border: 1px solid #000;\n        padding: 4px 7px;\n        font-size: 13px;\n        font-weight: bold;\n        margin-top: 9px;\n        text-transform: uppercase;\n    }\n\n    .section {\n        border: 1px solid #000;\n        border-top: none;\n        padding: 5px 6px;\n    }\n\n    table.field {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    table.field td {\n        padding: 3px 4px;\n        font-size: 12px;\n        vertical-align: top;\n    }\n\n    table.field td.lbl {\n        font-weight: bold;\n        width: 34%;\n    }\n\n    table.field td.lbl2 {\n        font-weight: bold;\n        width: 24%;\n    }\n\n    td.spacer {\n        width: 1%;\n    }\n\n    /* ============ GRILLE ============ */\n    .semester-title {\n        font-weight: bold;\n        font-size: 13px;\n        margin-top: 10px;\n        margin-bottom: 3px;\n        text-transform: uppercase;\n    }\n\n    table.grid {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 12px;\n    }\n\n    table.grid th,\n    table.grid td {\n        border: 1px solid #000;\n        padding: 4px 6px;\n    }\n\n    table.grid th {\n        background: #e5e5e5;\n        font-weight: bold;\n        text-align: center;\n    }\n\n    table.grid td.center {\n        text-align: center;\n    }\n\n    table.grid td.total {\n        font-weight: bold;\n        text-align: right;\n        padding-right: 8px;\n    }\n\n    .no-grid {\n        border: 1px solid #000;\n        padding: 18px 10px;\n        text-align: center;\n        font-style: italic;\n        font-size: 12px;\n        margin-top: 10px;\n    }\n\n    /* ============ PIED DE PAGE ============ */\n    .footer {\n        position: absolute;\n        bottom: 0;\n        left: 0;\n        right: 0;\n        border-top: 1px solid #000;\n        padding-top: 5px;\n        text-align: center;\n        font-size: 9px;\n    }\n\n    .footer .generation {\n        margin-bottom: 3px;\n    }\n\n    .footer .contact {\n        margin-top: 2px;\n    }\n\n    .certification {\n        margin-top: 16px;\n        font-size: 12px;\n        line-height: 1.5;\n    }\n\n    .signature {\n        margin-top: 26px;\n        font-size: 12px;\n    }\n</style>\n\n{% set infos = frappe.get_module(\"udshed.api.inscription\").donnees_fiche_inscription(doc) %}\n{% set etab = infos[\"etablissement\"] %}\n{% set date_jour = frappe.utils.formatdate(frappe.utils.today(), \"dd/mm/yyyy\") %}\n{% set contacts = [etab[\"school_address\"], etab[\"school_phone\"], etab[\"school_email\"], etab[\"school_website\"] | string] %}\n\n<!-- =============================================================\n     PAGE 1  —  IDENTIFICATION\n============================================================= -->\n<div class=\"page\">\n\n    <div class=\"header\">\n        <img src=\"{{ get_logo_data_uri() }}\" class=\"logo\" alt=\"{{ etab['school_name'] }}\">\n        <div class=\"university\">{{ etab[\"school_name\"] }}</div>\n        {% if etab[\"school_institute\"] %}<div class=\"institute\">{{ etab[\"school_institute\"] }}</div>{% endif %}\n        <div class=\"department\">{{ infos[\"departement\"] }}</div>\n        <div class=\"year\">{{ infos[\"annee_academique\"] }}</div>\n        <div class=\"header-title\">Fiche d'inscription administrative et académique</div>\n        <div class=\"header-subtitle\">Administrative and Academic Registration File</div>\n\n        <div class=\"student-info\">\n            <span>{{ infos[\"classe_tag\"] }}</span>\n            <span>Matricule : {{ infos[\"matricule\"] }}</span>\n            <span>N° dossier : {{ infos[\"numero_dossier\"] }}</span>\n        </div>\n    </div>\n\n    <!-- IDENTIFICATION DE L'ETUDIANT -->\n    <div class=\"section-title\">Identification de l'étudiant</div>\n    <div class=\"section\">\n        <table class=\"field\">\n            <tr>\n                <td class=\"lbl\">Nom(s) et Prénom(s) :</td>\n                <td>{{ doc.nom_prenom or \"\" }}</td>\n                <td class=\"lbl2\">Sexe :</td>\n                <td>{{ doc.sexe or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Date de naissance :</td>\n                <td>{{ frappe.utils.formatdate(doc.date_naissance, \"dd/mm/yyyy\") if doc.date_naissance else \"\" }}</td>\n                <td class=\"lbl2\">Lieu de naissance :</td>\n                <td>{{ doc.lieu_naissance or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Nationalité :</td>\n                <td>{{ doc.nationalite or \"\" }}</td>\n                <td class=\"lbl2\">Région d'origine :</td>\n                <td>{{ doc.region_origine or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Langue :</td>\n                <td>{{ doc.langue or \"\" }}</td>\n                <td class=\"lbl2\">Handicapé :</td>\n                <td>{{ doc.handicape or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Religion :</td>\n                <td>{{ doc.religion or \"\" }}</td>\n                <td class=\"lbl2\">Situation matrimoniale :</td>\n                <td>{{ doc.situation_matrimoniale or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Situation d'emploi :</td>\n                <td>{{ doc.situatio_emploi or \"\" }}</td>\n                <td class=\"lbl2\">N° Téléphone :</td>\n                <td>{{ doc.telephone or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Email :</td>\n                <td colspan=\"3\">{{ doc.email or \"\" }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- IDENTIFICATION DU PERE -->\n    <div class=\"section-title\">Identification du Père</div>\n    <div class=\"section\">\n        <table class=\"field\">\n            <tr>\n                <td class=\"lbl\">Nom(s) et prénom(s) :</td>\n                <td>{{ doc.nom_prenom_pere or \"\" }}</td>\n                <td class=\"lbl2\">Profession :</td>\n                <td>{{ doc.pere_profession or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">N° téléphone :</td>\n                <td>{{ doc.pere_telephone or \"\" }}</td>\n                <td class=\"lbl2\">Ville de résidence :</td>\n                <td>{{ doc.pere_ville or \"\" }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- IDENTIFICATION DE LA MERE -->\n    <div class=\"section-title\">Identification de la Mère</div>\n    <div class=\"section\">\n        <table class=\"field\">\n            <tr>\n                <td class=\"lbl\">Nom(s) et prénom(s) :</td>\n                <td>{{ doc.nom_prenom_mere or \"\" }}</td>\n                <td class=\"lbl2\">Profession :</td>\n                <td>{{ doc.profession_mere or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">N° téléphone :</td>\n                <td>{{ doc.telephone_mere or \"\" }}</td>\n                <td class=\"lbl2\">Ville de résidence :</td>\n                <td>{{ doc.mere_ville or \"\" }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- IDENTIFICATION DU SPONSOR -->\n    <div class=\"section-title\">Identification du Sponsor</div>\n    <div class=\"section\">\n        <table class=\"field\">\n            <tr>\n                <td class=\"lbl\">Nom(s) et prénom(s) :</td>\n                <td>{{ doc.nom_prenom_sponsor or \"\" }}</td>\n                <td class=\"lbl2\">Profession :</td>\n                <td>{{ doc.profession_sponsor or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">N° téléphone :</td>\n                <td>{{ doc.telephone_sponsor or \"\" }}</td>\n                <td class=\"lbl2\">Ville de résidence :</td>\n                <td>{{ doc.sponsor_ville or \"\" }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- ETUDES ANTERIEURES -->\n    <div class=\"section-title\">Études antérieures</div>\n    <div class=\"section\">\n        <table class=\"field\">\n            <tr>\n                <td class=\"lbl\">Dernier établissement :</td>\n                <td>{{ doc.dernier_etablissement or \"\" }}</td>\n                <td class=\"lbl2\">Diplôme d'entrée :</td>\n                <td>{{ doc.diplome_entree or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Matricule du diplôme :</td>\n                <td colspan=\"3\">{{ doc.matricule_diplome or \"\" }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- INFORMATIONS COMPLEMENTAIRES -->\n    <div class=\"section-title\">Informations complémentaires</div>\n    <div class=\"section\">\n        <table class=\"field\">\n            <tr>\n                <td class=\"lbl\">Activité(s) sportive(s) :</td>\n                <td colspan=\"3\">{{ doc.activites_sportives or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Activité(s) associative(s) :</td>\n                <td colspan=\"3\">{{ doc.activites_associatives or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Activité(s) culturelle(s) :</td>\n                <td colspan=\"3\">{{ doc.activites_culturelles or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Connaissances informatiques :</td>\n                <td colspan=\"3\">{{ doc.connaissances_informatiques or \"\" }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"footer\">\n        <div class=\"generation\">Fiche générée le {{ date_jour }}</div>\n        <div class=\"contact\">{{ contacts | select(\"string\") | join(\"   |   \") }}</div>\n    </div>\n\n</div>\n\n<!-- =============================================================\n     PAGE 2  —  GRILLE D'ENSEIGNEMENT\n============================================================= -->\n<div class=\"page\">\n\n    <div class=\"header\">\n        <div class=\"university\">{{ etab[\"school_name\"] }}</div>\n        {% if etab[\"school_institute\"] %}<div class=\"institute\">{{ etab[\"school_institute\"] }}</div>{% endif %}\n        <div class=\"department\">{{ infos[\"departement\"] }}</div>\n        <div class=\"year\">{{ infos[\"annee_academique\"] }}</div>\n        <div class=\"header-title\">Inscription académique</div>\n    </div>\n\n    <p style=\"font-size:13px; margin-top:12px;\">\n        Liste exhaustive des unités d'enseignement auxquelles vous prendrez part\n        au cours de l'année académique :\n    </p>\n\n    {% if infos[\"grille\"] %}\n        {% for sem in infos[\"grille\"] %}\n            <div class=\"semester-title\">{{ sem[\"label\"] }}</div>\n            <table class=\"grid\">\n                <thead>\n                    <tr>\n                        <th style=\"width:8%;\">N°</th>\n                        <th style=\"width:20%;\">Code</th>\n                        <th>Intitulé</th>\n                        <th style=\"width:12%;\">Crédits</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for row in sem[\"rows\"] %}\n                    <tr>\n                        <td class=\"center\">{{ loop.index }}</td>\n                        <td class=\"center\">{{ row[\"code\"] }}</td>\n                        <td>{{ row[\"intitule\"] }}</td>\n                        <td class=\"center\">{{ row[\"credits\"] }}</td>\n                    </tr>\n                    {% endfor %}\n                    <tr>\n                        <td colspan=\"3\" class=\"total\">Total crédits inscrits</td>\n                        <td class=\"center\"><strong>{{ sem[\"total\"] }}</strong></td>\n                    </tr>\n                </tbody>\n            </table>\n        {% endfor %}\n    {% else %}\n        <div class=\"no-grid\">Aucune unité d'enseignement configurée pour cette filière et ce niveau.</div>\n    {% endif %}\n\n    <div class=\"certification\">\n        <strong>\n            Je certifie que les informations que je fournis à travers le présent\n            formulaire sont exactes et vérifiables.\n        </strong>\n    </div>\n\n    <div class=\"signature\">\n        Fait à __________________________ le ____/____/________\n    </div>\n\n    <div class=\"footer\">\n        <div class=\"contact\">{{ contacts | select(\"string\") | join(\"   |   \") }}</div>\n    </div>\n\n</div>",
