 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    @page {\n        size: A4;\n        margin: 15mm 15mm 20mm 15mm;\n    }\n\n    body {\n        font-family: \"Times New Roman\", Times, serif;\n        font-size: 9pt;\n        line-height: 1.45;\n        color: #2c3e50;\n        margin: 0;\n        padding: 0;\n    }\n\n    .fiche { max-width: 210mm; margin: 0 auto; }\n\n    /* ---- Header ---- */\n    .header {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        padding: 10px 0;\n        border-bottom: 3px solid #1a5276;\n        margin-bottom: 4px;\n    }\n\n    .header .logo-box { width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; }\n    .header .logo-box img { max-width: 80px; max-height: 80px; }\n    .header .logo-placeholder { width: 80px; height: 80px; border-radius: 50%; background: #eef2f7; display: flex; align-items: center; justify-content: center; font-size: 8pt; color: #95a5a6; text-align: center; }\n\n    .header .title-area { flex: 1; text-align: center; padding: 0 15px; }\n    .header .title-area .school-name { font-size: 12pt; font-weight: 800; color: #1a5276; margin: 0 0 2px 0; text-transform: uppercase; letter-spacing: 0.5px; }\n    .header .title-area .doc-title { font-size: 13pt; font-weight: 800; color: #fff; background: #1a5276; display: inline-block; padding: 4px 26px; border-radius: 3px; letter-spacing: 1px; margin-top: 4px; }\n\n    /* ---- Info block ---- */\n    .info-block { border: 1px solid #d5dbdb; border-radius: 4px; padding: 10px 14px; margin: 12px 0; background: #f8f9fa; }\n    .info-block table { width: 100%; border-collapse: collapse; }\n    .info-block td { padding: 3px 8px; vertical-align: top; font-size: 9pt; }\n    .info-block .label { font-weight: 600; color: #1a5276; width: 33%; white-space: nowrap; }\n    .info-block .value { font-weight: 400; color: #2c3e50; }\n\n    .matricule-box { text-align: center; background: #eaf2f8; border: 1px dashed #1a5276; border-radius: 4px; padding: 8px; margin: 12px 0; }\n    .matricule-box .matricule { font-size: 16pt; font-weight: 800; color: #1a5276; letter-spacing: 2px; }\n\n    /* ---- Section titles ---- */\n    .section-title { font-size: 10pt; font-weight: 700; color: #fff; background: #1a5276; padding: 4px 12px; border-radius: 3px; margin: 14px 0 8px 0; text-transform: uppercase; letter-spacing: 0.5px; }\n    .sub-section-title { font-size: 9pt; font-weight: 700; color: #1a5276; border-bottom: 1px solid #1a5276; padding: 6px 0 2px 0; margin: 10px 0 6px 0; }\n\n    /* ---- Two-column field tables ---- */\n    .fields-table { width: 100%; border-collapse: collapse; font-size: 8.5pt; }\n    .fields-table td { padding: 4px 6px; border: 1px solid #d5dbdb; vertical-align: top; }\n    .fields-table .lbl { width: 30%; font-weight: 600; color: #1a5276; background: #f0f5fa; }\n    .fields-table .val { width: 70%; }\n\n    .data-table { width: 100%; border-collapse: collapse; font-size: 8.5pt; margin: 6px 0; }\n    .data-table th { background: #eaf2f8; color: #1a5276; font-weight: 700; padding: 5px 6px; text-align: left; border-bottom: 2px solid #1a5276; font-size: 8pt; text-transform: uppercase; letter-spacing: 0.3px; }\n    .data-table td { padding: 4px 6px; border-bottom: 1px solid #eef2f7; }\n\n    .nom-vide { color: #b0b7c0; font-style: italic; }\n\n    /* ---- Signature footer ---- */\n    .footer { margin-top: 24px; }\n    .footer .signature-area { display: flex; justify-content: space-between; margin-bottom: 14px; }\n    .footer .sig-box { text-align: center; min-width: 150px; }\n    .footer .sig-box .sig-line { border-top: 1px solid #2c3e50; width: 150px; margin: 34px auto 4px auto; }\n    .footer .sig-box .sig-label { font-size: 8pt; color: #7f8c8d; }\n    .footer .contact-info { font-size: 7.5pt; color: #7f8c8d; text-align: center; padding-top: 6px; border-top: 1px solid #eef2f7; }\n\n    @media print { .fiche { max-width: 100%; } }\n.watermark {\n    position: fixed;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%) rotate(-28deg);\n    opacity: 0.08;\n    z-index: 0;\n    pointer-events: none;\n}\n</style>\n\n<div class=\"fiche\">\n<div class=\"watermark\"><img src=\"{{ frappe.utils.get_url((frappe.db.get_single_value('Udshed Setting', 'school_logo') or '/assets/udshed/images/logo.png')) }}\" style=\"width:320px;opacity:1;\"></div>\n\n    {# ------------------------------------------------------------------ #}\n    {#  HEADER                                                            #}\n    {# ------------------------------------------------------------------ #}\n    <div class=\"header\">\n        <div class=\"logo-box\">\n            {% set logo = frappe.db.get_single_value('Udshed Setting', 'school_logo') %}\n            {% if logo %}\n                <img src=\"{{ logo }}\" alt=\"Logo\">\n            {% else %}\n                <div class=\"logo-placeholder\">{{ _(\"LOGO\") }}</div>\n            {% endif %}\n        </div>\n        <div class=\"title-area\">\n            <div class=\"school-name\">{{ _(\"UNIVERSIT\\u00c9 UDSHED\") }}</div>\n            <div class=\"doc-title\">{{ _(\"FICHE D'INSCRIPTION\") }}</div>\n        </div>\n        <div class=\"logo-placeholder\">{{ _(\"Institut\") }}</div>\n    </div>\n\n    {# ---------------------------------------------------------------- #}\n    {#  REFERENCE / MATRICULE                                            #}\n    {# ---------------------------------------------------------------- #}\n    <div class=\"matricule-box\">\n        <div style=\"font-size:8pt;color:#5d6d7e;text-transform:uppercase;letter-spacing:0.5px;\">{{ _(\"Matricule\") }}</div>\n        <div class=\"matricule\">{{ doc.matricule or \"\" }}</div>\n    </div>\n\n    <div class=\"info-block\">\n        <table>\n            <tr>\n                <td class=\"label\">{{ _(\"Nom et Pr\\u00e9nom\") }} :</td>\n                <td class=\"value\">{{ doc.nom_prenom or \"\" }}</td>\n                <td class=\"label\">{{ _(\"N\\u00b0 dossier\") }} :</td>\n                <td class=\"value\">{{ doc.dossier_origine or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"label\">{{ _(\"Ann\\u00e9e acad\\u00e9mique\") }} :</td>\n                <td class=\"value\">{{ doc.annee_academique or \"\" }}</td>\n                <td class=\"label\">{{ _(\"Date\") }} :</td>\n                <td class=\"value\">{{ frappe.utils.formatdate(frappe.utils.today(), \"dd/mm/yyyy\") }}</td>\n            </tr>\n        </table>\n    </div>\n\n    {# ---------------------------------------------------------------- #}\n    {#  INFORMATIONS ACADEMIQUES                                         #}\n    {# ---------------------------------------------------------------- #}\n    <div class=\"section-title\">{{ _(\"Informations acad\\u00e9miques\") }}</div>\n    <table class=\"fields-table\">\n        <tr>\n            <td class=\"lbl\">{{ _(\"Fili\\u00e8re\") }}</td><td class=\"val\">{{ doc.filiere or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"Classe / Niveau\") }}</td><td class=\"val\">{{ doc.classe or \"\" }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl\">{{ _(\"Sexe\") }}</td><td class=\"val\">{{ doc.sexe or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"Nationalit\\u00e9\") }}</td><td class=\"val\">{{ doc.nationalite or \"\" }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl\">{{ _(\"R\\u00e9gion d'origine\") }}</td><td class=\"val\">{{ doc.region_origine or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"Langue\") }}</td><td class=\"val\">{{ doc.langue or \"\" }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl\">{{ _(\"Religion\") }}</td><td class=\"val\">{{ doc.religion or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"Situation matrimoniale\") }}</td><td class=\"val\">{{ doc.situation_matrimoniale or \"\" }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl\">{{ _(\"Situation d'emploi\") }}</td><td class=\"val\">{{ doc.situatio_emploi or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"Handicap\") }}</td><td class=\"val\">{{ doc.handicape or \"\" }}</td>\n        </tr>\n    </table>\n\n    <div class=\"section-title\">{{ _(\"Informations personnelles\") }}</div>\n    <table class=\"fields-table\">\n        <tr>\n            <td class=\"lbl\">{{ _(\"Date de naissance\") }}</td><td class=\"val\">{{ frappe.utils.formatdate(doc.date_naissance, \"dd/mm/yyyy\") if doc.date_naissance else \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"Lieu de naissance\") }}</td><td class=\"val\">{{ doc.lieu_naissance or \"\" }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl\">{{ _(\"Email\") }}</td><td class=\"val\" colspan=\"3\">{{ doc.email or \"\" }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl\">{{ _(\"T\\u00e9l\\u00e9phone\") }}</td><td class=\"val\" colspan=\"3\">{{ doc.telephone or \"\" }}</td>\n        </tr>\n    </table>\n\n    <div class=\"section-title\">{{ _(\"Études ant\\u00e9rieures\") }}</div>\n    <table class=\"fields-table\">\n        <tr>\n            <td class=\"lbl\">{{ _(\"Dernier \\u00e9tablissement\") }}</td><td class=\"val\" colspan=\"3\">{{ doc.dernier_etablissement or \"\" }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl\">{{ _(\"Dipl\\u00f4me d'entr\\u00e9e\") }}</td><td class=\"val\">{{ doc.diplome_entree or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"Matricule du dipl\\u00f4me\") }}</td><td class=\"val\">{{ doc.matricule_diplome or \"\" }}</td>\n        </tr>\n    </table>\n\n    {# ---------------------------------------------------------------- #}\n    {#  FAMILLE                                                          #}\n    {# ---------------------------------------------------------------- #}\n    <div class=\"section-title\">{{ _(\"Informations familiales\") }}</div>\n\n    <div class=\"sub-section-title\">{{ _(\"P\\u00e8re\") }}</div>\n    <table class=\"fields-table\">\n        <tr>\n            <td class=\"lbl\">{{ _(\"Nom et pr\\u00e9nom\") }}</td><td class=\"val\">{{ doc.nom_prenom_pere or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"T\\u00e9l\\u00e9phone\") }}</td><td class=\"val\">{{ doc.pere_telephone or \"\" }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl\">{{ _(\"Profession\") }}</td><td class=\"val\">{{ doc.pere_profession or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"Ville\") }}</td><td class=\"val\">{{ doc.pere_ville or \"\" }}</td>\n        </tr>\n    </table>\n\n    <div class=\"sub-section-title\">{{ _(\"M\\u00e8re\") }}</div>\n    <table class=\"fields-table\">\n        <tr>\n            <td class=\"lbl\">{{ _(\"Nom et pr\\u00e9nom\") }}</td><td class=\"val\">{{ doc.nom_prenom_mere or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"T\\u00e9l\\u00e9phone\") }}</td><td class=\"val\">{{ doc.telephone_mere or \"\" }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl\">{{ _(\"Profession\") }}</td><td class=\"val\">{{ doc.profession_mere or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"Ville\") }}</td><td class=\"val\">{{ doc.mere_ville or \"\" }}</td>\n        </tr>\n    </table>\n\n    <div class=\"sub-section-title\">{{ _(\"Sponsor\") }}</div>\n    <table class=\"fields-table\">\n        <tr>\n            <td class=\"lbl\">{{ _(\"Nom et pr\\u00e9nom\") }}</td><td class=\"val\">{{ doc.nom_prenom_sponsor or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"T\\u00e9l\\u00e9phone\") }}</td><td class=\"val\">{{ doc.telephone_sponsor or \"\" }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl\">{{ _(\"Profession\") }}</td><td class=\"val\">{{ doc.profession_sponsor or \"\" }}</td>\n            <td class=\"lbl\">{{ _(\"Ville\") }}</td><td class=\"val\">{{ doc.sponsor_ville or \"\" }}</td>\n        </tr>\n    </table>\n\n    {# ---------------------------------------------------------------- #}\n    {#  INFORMATIONS COMPLEMENTAIRES                                     #}\n    {# ---------------------------------------------------------------- #}\n    <div class=\"section-title\">{{ _(\"Informations compl\\u00e9mentaires\") }}</div>\n    <table class=\"data-table\">\n        <tr>\n            <th style=\"width:50%;\">{{ _(\"Activit\\u00e9\") }}</th><th>{{ _(\"D\\u00e9tails\") }}</th>\n        </tr>\n        <tr><td>{{ _(\"Activit\\u00e9s sportives\") }}</td><td>{{ doc.activites_sportives or \"\" }}</td></tr>\n        <tr><td>{{ _(\"Activit\\u00e9s associatives\") }}</td><td>{{ doc.activites_associatives or \"\" }}</td></tr>\n        <tr><td>{{ _(\"Activit\\u00e9s culturelles\") }}</td><td>{{ doc.activites_culturelles or \"\" }}</td></tr>\n        <tr><td>{{ _(\"Connaissances informatiques\") }}</td><td>{{ doc.connaissances_informatiques or \"\" }}</td></tr>\n    </table>\n\n    {# ---------------------------------------------------------------- #}\n    {#  FOOTER SIGNATURES                                                #}\n    {# ---------------------------------------------------------------- #}\n    <div class=\"footer\">\n        <div class=\"signature-area\">\n            <div class=\"sig-box\"><div class=\"sig-line\"></div><div class=\"sig-label\">{{ _(\"L'\\u00c9tudiant(e)\") }}</div></div>\n            <div class=\"sig-box\"><div class=\"sig-line\"></div><div class=\"sig-label\">{{ _(\"Le Secr\\u00e9tariat\") }}</div></div>\n            <div class=\"sig-box\"><div class=\"sig-line\"></div><div class=\"sig-label\">{{ _(\"Le Chef d'\\u00c9tablissement\") }}</div></div>\n        </div>\n        <div class=\"contact-info\">\n            {{ _(\"DOCUMENT G\\u00c9N\\u00c9R\\u00c9 LE\") }}\n            {{ frappe.utils.formatdate(frappe.utils.today(), \"dd/mm/yyyy\") }}\n            &nbsp;—&nbsp; {{ _(\"MATRICULE\") }} : {{ doc.matricule or \"\" }}\n        </div>\n    </div>\n</div>\n", "idx": 0,
