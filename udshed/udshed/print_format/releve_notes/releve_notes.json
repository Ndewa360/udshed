{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-08-07 12:53:40.070246",
 "css": "",
 "custom_format": 0,
 "disabled": 0,
 "doc_type": "Student",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    @page {\n        size: A4;\n        margin: 12mm 14mm 14mm 14mm;\n    }\n\n    body {\n        font-family: \"Times New Roman\", Times, serif;\n        color: #111;\n        margin: 0;\n        padding: 0;\n        font-size: 7pt;\n    }\n\n    .wm-logo {\n        position: fixed;\n        top: 50%;\n        left: 50%;\n        transform: translate(-50%, -50%) rotate(-28deg);\n        opacity: 0.06;\n        z-index: 0;\n        pointer-events: none;\n    }\n    .wm-logo img {\n        width: 170mm;\n    }\n\n    .transcript {\n        position: relative;\n        z-index: 1;\n        max-width: 210mm;\n        margin: 0 auto;\n    }\n\n    /* ---------- En-t\u00eate ---------- */\n    .header {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        min-height: 60px;\n    }\n\n    .university-logo {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n    }\n\n    .logo-symbol {\n        width: 55px;\n        height: 55px;\n        border: 3px solid #777;\n        border-radius: 50%;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        overflow: hidden;\n    }\n    .logo-symbol img {\n        max-width: 48px;\n        max-height: 48px;\n    }\n    .logo-symbol .logo-letter {\n        font-size: 15.1pt;\n        font-weight: bold;\n        color: #356b50;\n    }\n\n    .university-name {\n        font-size: 8.1pt;\n        line-height: 1.1;\n    }\n\n    .institution {\n        text-align: center;\n        display: flex;\n        flex-direction: column;\n        font-size: 7.5pt;\n        line-height: 1.4;\n    }\n\n    .separator {\n        border-top: 2px solid #222;\n        margin: 10px 0 12px;\n    }\n\n    /* ---------- Titre ---------- */\n    .document-title {\n        height: 34px;\n        background: #75b58c;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        font-size: 9.2pt;\n        margin-bottom: 16px;\n    }\n    .document-title span {\n        color: #092a68;\n        font-weight: bold;\n    }\n    .document-title em {\n        color: #d72d27;\n        margin-left: 5px;\n    }\n\n    /* ---------- Informations \u00e9tudiant ---------- */\n    .student-info {\n        display: flex;\n        justify-content: space-between;\n        gap: 30px;\n        font-size: 7.0pt;\n        margin-bottom: 14px;\n    }\n\n    .info-column {\n        flex: 1;\n        display: flex;\n        flex-direction: column;\n        gap: 5px;\n    }\n\n    .info-row {\n        display: flex;\n        gap: 10px;\n    }\n    .info-row label {\n        white-space: nowrap;\n        min-width: 150px;\n    }\n    .info-row .en {\n        font-style: italic;\n        font-size: 5.9pt;\n    }\n    .info-row strong {\n        font-weight: bold;\n    }\n\n    /* ---------- R\u00e9capitulatif g\u00e9n\u00e9ral ---------- */\n    .global-summary h3 {\n        text-align: center;\n        font-size: 7.5pt;\n        margin: 8px 0;\n    }\n\n    .summary-line {\n        display: flex;\n        justify-content: space-between;\n        font-size: 7.0pt;\n        margin-bottom: 12px;\n    }\n    .summary-line strong {\n        margin-left: 8px;\n    }\n\n    /* ---------- Semestre ---------- */\n    .semester {\n        margin-top: 14px;\n    }\n\n    .semester-title {\n        text-align: center;\n        font-size: 7.8pt;\n        padding: 3px;\n        border: 1px solid #bbb;\n        border-bottom: none;\n    }\n\n    .grades-table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 6.5pt;\n    }\n    .grades-table th,\n    .grades-table td {\n        border: 1px solid #b8b8b8;\n        padding: 4px 6px;\n    }\n    .grades-table th {\n        text-align: center;\n        font-weight: normal;\n        background: #fafafa;\n    }\n    .grades-table th i {\n        font-size: 5.7pt;\n    }\n    .grades-table td:first-child {\n        width: 12%;\n    }\n    .grades-table td:nth-child(2) {\n        width: 44%;\n    }\n    .grades-table td:nth-child(3),\n    .grades-table td:nth-child(4),\n    .grades-table td:nth-child(5),\n    .grades-table td:nth-child(6) {\n        text-align: center;\n    }\n    .grades-table .rattrapage {\n        color: #c0392b;\n        font-weight: bold;\n    }\n\n    /* ---------- R\u00e9capitulatif semestre ---------- */\n    .semester-summary {\n        margin-top: 8px;\n    }\n    .semester-summary h4 {\n        text-align: center;\n        font-size: 7.3pt;\n        margin: 4px 0 6px;\n    }\n    .summary-grid {\n        display: flex;\n        justify-content: space-between;\n        font-size: 6.5pt;\n    }\n    .summary-grid p {\n        margin: 2px 0;\n    }\n\n    /* ---------- R\u00e9capitulatif annuel ---------- */\n    .annual-summary {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 6.7pt;\n        margin-top: 14px;\n    }\n    .annual-summary th,\n    .annual-summary td {\n        border: 1px solid #b8b8b8;\n        padding: 5px 8px;\n    }\n    .annual-summary th {\n        background: #fafafa;\n        text-align: left;\n    }\n\n    /* ---------- D\u00e9cision ---------- */\n    .decision {\n        width: 70%;\n        margin: 14px auto 16px;\n        font-size: 7.5pt;\n    }\n    .decision div {\n        display: flex;\n        justify-content: space-between;\n        margin: 4px 0;\n    }\n    .decision span {\n        font-weight: bold;\n    }\n\n    /* ---------- \u00c9chelle des notes ---------- */\n    .grading-scale {\n        width: 34%;\n        font-size: 5.1pt;\n        margin-top: 8px;\n    }\n    .grading-scale h4 {\n        text-align: center;\n        margin: 0;\n        background: #111;\n        color: #fff;\n        padding: 2px;\n        font-size: 5.4pt;\n    }\n    .grading-scale table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n    .grading-scale td,\n    .grading-scale th {\n        border: 1px solid #aaa;\n        text-align: center;\n        padding: 1.5px 2px;\n    }\n\n    /* ---------- Signature ---------- */\n    .signature {\n        margin-top: 35px;\n        display: flex;\n        justify-content: flex-end;\n        gap: 40px;\n        font-size: 7.0pt;\n    }\n    .date {\n        display: flex;\n        gap: 8px;\n        align-items: center;\n    }\n    .signature-box {\n        width: 180px;\n        text-align: center;\n    }\n    .signature-box span {\n        display: block;\n        margin-bottom: 28px;\n    }\n    .signature-line {\n        border-top: 1px solid #333;\n    }\n\n    /* ---------- Pied de page ---------- */\n    .footer {\n        border-top: 2px solid #222;\n        margin-top: 20px;\n        padding-top: 6px;\n        text-align: center;\n        font-size: 5.7pt;\n    }\n\n    .empty-state {\n        text-align: center;\n        padding: 25px;\n        color: #95a5a6;\n        font-size: 5.4pt;\n    }\n</style>\n\n<div class=\"wm-logo\">\n    <img src=\"{{ data.logo_file }}\" alt=\"\">\n</div>\n\n<div class=\"transcript\">\n    {#\n        Donn\u00e9es (get_transcript_data \u2014 disponibles dans `data`) :\n          data.semesters[]            \u2014 semestres (ues, mps/mpc %, mps/mpc sur 4, cr\u00e9dits)\n          data.grade_scale[]          \u2014 grille d'\u00e9quivalence des grades\n          data.student                \u2014 matricule, nom, prenom, birth_date, birth_place\n          data.school_name / data.school_logo\n          data.total_credits / data.total_credits_obtenus / data.pct_validation\n          data.cumulative_gpa         \u2014 MPC cumul\u00e9e sur 4\n          data.highest_gpa            \u2014 meilleure MPS sur 4 du cycle\n          data.profil                 \u2014 derni\u00e8re mention connue\n          data.overall_decision       \u2014 d\u00e9cision finale\n          data.reference_no / data.date_emission\n          data.filiere_name / data.niveau_label / data.cycle\n    #}\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 EN-T\u00caTE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <div class=\"header\">\n        <div class=\"university-logo\">\n            <div class=\"logo-symbol\">\n                {% if data.school_logo %}\n                    <img src=\"{{ data.school_logo }}\" alt=\"Logo\">\n                {% else %}\n                    <span class=\"logo-letter\">\n                        {{ (data.school_name or \"U\")[:1] | upper }}\n                    </span>\n                {% endif %}\n            </div>\n            <div class=\"university-name\">\n                <strong>{{ data.school_name or _(\"UNIVERSIT\u00c9\") }}</strong>\n            </div>\n        </div>\n\n        <div class=\"institution\">\n            <strong>{{ data.school_name or _(\"UNIVERSIT\u00c9\") }}</strong>\n        </div>\n    </div>\n\n    <div class=\"separator\"></div>\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 TITRE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <div class=\"document-title\">\n        <span>{{ _(\"RELEV\u00c9 DE NOTES\") }}</span>\n        <em>/ TRANSCRIPT</em>\n    </div>\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 INFORMATIONS \u00c9TUDIANT \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <section class=\"student-info\">\n        <div class=\"info-column\">\n            <div class=\"info-row\">\n                <label>\n                    {{ _(\"N\u00b0 Matricule\") }} /\n                    <span class=\"en\">Registration Number:</span>\n                </label>\n                <strong>{{ data.student.matricule }}</strong>\n            </div>\n            <div class=\"info-row\">\n                <label>\n                    {{ _(\"Nom(s) et Pr\u00e9nom(s)\") }} /\n                    <span class=\"en\">Name and surname:</span>\n                </label>\n                <strong>\n                    {{ (data.student.nom or \"\") | upper }} {{ data.student.prenom or \"\" }}\n                </strong>\n            </div>\n            <div class=\"info-row\">\n                <label>\n                    {{ _(\"N\u00e9(e) le\") }} /\n                    <span class=\"en\">Born on:</span>\n                </label>\n                <strong>\n                    {{ frappe.utils.formatdate(data.student.birth_date, \"dd/mm/yyyy\") if data.student.birth_date else \"\" }}\n                </strong>\n            </div>\n            <div class=\"info-row\">\n                <label>\n                    {{ _(\"Dipl\u00f4me pr\u00e9par\u00e9\") }} /\n                    <span class=\"en\">Degree:</span>\n                </label>\n                <strong>{{ data.cycle }} {{ data.filiere_name }}</strong>\n            </div>\n        </div>\n\n        <div class=\"info-column\">\n            <div class=\"info-row\">\n                <label>{{ _(\"N\u00b0 RFE\") }} :</label>\n                <strong>{{ data.reference_no }}</strong>\n            </div>\n            <div class=\"info-row\">\n                <label>\n                    {{ _(\"\u00e0\") }} /\n                    <span class=\"en\">at:</span>\n                </label>\n                <strong>{{ data.student.birth_place or \"\" }}</strong>\n            </div>\n            <div class=\"info-row\">\n                <label>\n                    {{ _(\"Niveau\") }} /\n                    <span class=\"en\">Level:</span>\n                </label>\n                <strong>{{ data.niveau_label }}</strong>\n            </div>\n            <div class=\"info-row\">\n                <label>\n                    {{ _(\"Ann\u00e9e Acad\u00e9mique\") }} /\n                    <span class=\"en\">Academic Year:</span>\n                </label>\n                <strong>\n                    {% if data.semesters %}\n                        {{ (data.semesters | last).academic_year }}\n                    {% endif %}\n                </strong>\n            </div>\n        </div>\n    </section>\n\n    {% if data.semesters and data.semesters | length > 0 %}\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 R\u00c9CAPITULATIF G\u00c9N\u00c9RAL \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <section class=\"global-summary\">\n        <h3>\n            {{ _(\"R\u00c9CAPITULATIF SEMESTRE PAR\") }} /\n            <i>SUMMARY TABLE FOR SEMESTER</i>\n        </h3>\n\n        <div class=\"summary-line\">\n            <span>\n                {{ _(\"Total cr\u00e9dits capitalis\u00e9s\") }} /\n                <i>Total credits earned:</i>\n                <strong>{{ data.total_credits_obtenus }}</strong>\n            </span>\n            <span>\n                {{ _(\"Moyenne pond\u00e9r\u00e9e cumul\u00e9e\") }} /\n                <i>Cumulative GPA:</i>\n                <strong>\n                    {{ \"%.2f\" | format(data.cumulative_gpa) if data.cumulative_gpa is not none else \"\u2014\" }}\n                </strong>\n            </span>\n        </div>\n    </section>\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 PAR SEMESTRE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {% for sem in data.semesters %}\n    <section class=\"semester\">\n        <div class=\"semester-title\">\n            {{ sem.label }} <i>/ {{ sem.label | replace(\"Semestre\", \"Semester\") }}</i>\n            \u2014 {{ sem.academic_year }}\n        </div>\n\n        <table class=\"grades-table\">\n            <thead>\n                <tr>\n                    <th>{{ _(\"Code UE\") }}<br><i>Course code</i></th>\n                    <th>{{ _(\"Intitul\u00e9\") }}<br><i>Course title</i></th>\n                    <th>{{ _(\"Cr\u00e9dits\") }}<br><i>Credits</i></th>\n                    <th>{{ _(\"Note/100\") }}<br><i>Mark/100</i></th>\n                    <th>{{ _(\"Grade\") }}<br><i>Grade</i></th>\n                    <th>{{ _(\"Session\") }}<br><i>Session</i></th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for ue in sem.ues %}\n                <tr>\n                    <td>{{ ue.code }}</td>\n                    <td>{{ ue.intitule }}</td>\n                    <td>{{ ue.credits }}</td>\n                    <td>\n                        {{ \"%.2f\" | format(ue.note_pct) if ue.note_pct is not none else \"\u2014\" }}%\n                    </td>\n                    <td>{{ ue.grade }}</td>\n                    <td>\n                        {% if ue.est_rattrapage %}\n                            <span class=\"rattrapage\">{{ ue.session }}</span>\n                        {% else %}\n                            {{ ue.session }}\n                        {% endif %}\n                    </td>\n                </tr>\n                {% else %}\n                <tr>\n                    <td colspan=\"6\" class=\"empty-state\">\n                        {{ _(\"Aucune unit\u00e9 d'enseignement enregistr\u00e9e.\") }}\n                    </td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n\n        <div class=\"semester-summary\">\n            <h4>\n                {{ _(\"R\u00c9CAPITULATIF\") }} {{ sem.label | upper }} /\n                <i>SUMMARY FOR {{ sem.label | replace(\"Semestre\", \"Semester\") | upper }}</i>\n            </h4>\n\n            <div class=\"summary-grid\">\n                <div>\n                    <p>\n                        {{ _(\"Cr\u00e9dits semestriels inscrits\") }} :\n                        <strong>{{ sem.total_credits or 0 }}</strong>\n                    </p>\n                    <p>\n                        {{ _(\"Cr\u00e9dits semestriels valid\u00e9s\") }} :\n                        <strong>{{ sem.credits_obtenus or 0 }}</strong>\n                    </p>\n                    <p>\n                        {{ _(\"Total cr\u00e9dits valid\u00e9s\") }} :\n                        <strong>{{ sem.cum_credits_valides }}</strong>\n                    </p>\n                </div>\n                <div>\n                    <p>\n                        {{ _(\"Moyenne pond\u00e9r\u00e9e semestrielle\") }} :\n                        <strong>\n                            {{ \"%.2f\" | format(sem.mps_sur_4) if sem.mps_sur_4 is not none else \"\u2014\" }}\n                        </strong>\n                    </p>\n                    <p>\n                        {{ _(\"Meilleure MPS du cycle\") }} /\n                        <i>Highest semester GPA:</i>\n                        <strong>\n                            {{ \"%.2f\" | format(sem.highest_gpa) if sem.highest_gpa is not none else \"\u2014\" }}\n                        </strong>\n                    </p>\n                    <p>\n                        {{ _(\"Pourcentage de validation\") }} :\n                        <strong>\n                            {% if sem.cum_credits_inscrits %}\n                                {{ \"%.0f\" | format(sem.cum_credits_valides * 100 / sem.cum_credits_inscrits) }}%\n                            {% else %}\n                                \u2014\n                            {% endif %}\n                        </strong>\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    {% endfor %}\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 R\u00c9CAPITULATIF ANNUEL \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <section class=\"semester-summary\">\n        <h4>\n            {{ _(\"R\u00c9CAPITULATIF DE L'ANN\u00c9E ACAD\u00c9MIQUE\") }} /\n            <i>ACADEMIC YEAR SUMMARY</i>\n        </h4>\n        <table class=\"annual-summary\">\n            <tbody>\n                <tr>\n                    <th>{{ _(\"Cr\u00e9dits valid\u00e9s sur l'ann\u00e9e\") }}</th>\n                    <td>\n                        <strong>\n                            {{ data.annee_credits_valides }} / {{ data.annee_credits_inscrits }}\n                        </strong>\n                        ({{ _(\"sur 60\") }})\n                    </td>\n                </tr>\n                <tr>\n                    <th>{{ _(\"Pourcentage de validation\") }}</th>\n                    <td>\n                        <strong>{{ \"%.2f\" | format(data.annee_pct_validation) }}%</strong>\n                    </td>\n                </tr>\n                <tr>\n                    <th>{{ _(\"Profil acad\u00e9mique\") }}</th>\n                    <td><strong>{{ data.profil or \"\u2014\" }}</strong></td>\n                </tr>\n                <tr>\n                    <th>{{ _(\"Total cr\u00e9dits cumul\u00e9s valid\u00e9s\") }}</th>\n                    <td><strong>{{ data.total_credits_obtenus }} / {{ data.total_credits }}</strong></td>\n                </tr>\n            </tbody>\n        </table>\n    </section>\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 D\u00c9CISION \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <section class=\"decision\">\n        <div>\n            <strong>\n                {{ _(\"PROFIL ACAD\u00c9MIQUE\") }} /\n                <i>ACADEMIC STANDING:</i>\n            </strong>\n            <span>{{ data.profil or \"\u2014\" }}</span>\n        </div>\n        <div>\n            <strong>\n                {{ _(\"D\u00c9CISION\") }} /\n                <i>DECISION:</i>\n            </strong>\n            <span>\n                {% if data.overall_decision == \"Admis\" %}\n                    {{ _(\"ADMIS(E)\") }}\n                {% elif data.overall_decision == \"Ajourn\u00e9\" %}\n                    {{ _(\"AJOURN\u00c9(E)\") }}\n                {% elif data.overall_decision %}\n                    {{ data.overall_decision | upper }}\n                {% else %}\n                    \u2014\n                {% endif %}\n            </span>\n        </div>\n    </section>\n\n    {% else %}\n    <div class=\"empty-state\">\n        {{ _(\"Aucun r\u00e9sultat de semestre disponible pour cet \u00e9tudiant.\") }}\n    </div>\n    {% endif %}\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u00c9CHELLE DES NOTES \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {% if data.grade_scale and data.grade_scale | length > 0 %}\n    <section class=\"grading-scale\">\n        <h4>\n            {{ _(\"\u00c9CHELLE DE NOTES\") }} /\n            <i>GRADING SCALE</i>\n        </h4>\n        <table>\n            <thead>\n                <tr>\n                    <th>%</th>\n                    <th>/100</th>\n                    <th>{{ _(\"Grade\") }}</th>\n                    <th>{{ _(\"Points\") }}</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for g in data.grade_scale %}\n                <tr>\n                    <td>{{ \"%.0f\" | format(g.note_min) }}</td>\n                    <td>\n                        {{ \"%.0f\" | format(g.note_min) }}-{{ \"%.0f\" | format(g.note_max) }}\n                    </td>\n                    <td>{{ g.grade }}</td>\n                    <td>{{ \"%.2f\" | format(g.point) | replace(\".00\", \"\") }}</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </section>\n    {% endif %}\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 SIGNATURE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <section class=\"signature\">\n        <div class=\"date\">\n            {{ _(\"Fait \u00e0\") }}, {{ _(\"le\") }}\n            <strong>\n                {{ frappe.utils.formatdate(data.date_emission, \"dd MMMM yyyy\") }}\n            </strong>\n        </div>\n        <div class=\"signature-box\">\n            <span>{{ _(\"Le Doyen\") }}</span>\n            <div class=\"signature-line\"></div>\n        </div>\n    </section>\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 PIED DE PAGE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <footer class=\"footer\">\n        {{ data.school_name or _(\"UNIVERSIT\u00c9\") }} \u2014\n        {{ _(\"R\u00e9f\") }} : {{ data.reference_no }}\n    </footer>\n</div>\n",
