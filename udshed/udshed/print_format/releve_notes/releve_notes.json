{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-07-30 21:43:41.159405",
 "css": "",
 "custom_format": 0,
 "disabled": 0,
 "doc_type": "Student",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    @page {\n        size: A4;\n        margin: 15mm 15mm 20mm 15mm;\n    }\n\n    body {\n        font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n        font-size: 9pt;\n        line-height: 1.4;\n        color: #2c3e50;\n        margin: 0;\n        padding: 0;\n    }\n\n    .transcript {\n        max-width: 210mm;\n        margin: 0 auto;\n        padding: 0;\n    }\n\n    /* ---- Header ---- */\n    .header {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        padding: 12px 0;\n        border-bottom: 3px solid #1a5276;\n        margin-bottom: 0;\n    }\n\n    .header .logo-box {\n        width: 80px;\n        height: 80px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n    }\n\n    .header .logo-box img {\n        max-width: 80px;\n        max-height: 80px;\n    }\n\n    .header .title-area {\n        flex: 1;\n        text-align: center;\n        padding: 0 15px;\n    }\n\n    .header .title-area .school-name {\n        font-size: 11pt;\n        font-weight: 700;\n        color: #1a5276;\n        margin: 0 0 2px 0;\n        text-transform: uppercase;\n        letter-spacing: 0.5px;\n    }\n\n    .header .title-area .dept-name {\n        font-size: 9pt;\n        color: #34495e;\n        margin: 0 0 4px 0;\n    }\n\n    .header .title-area .doc-title {\n        font-size: 13pt;\n        font-weight: 800;\n        color: #fff;\n        background: #1a5276;\n        display: inline-block;\n        padding: 4px 30px;\n        border-radius: 3px;\n        letter-spacing: 1px;\n        margin-top: 4px;\n    }\n\n    /* ---- Student Info Block ---- */\n    .info-block {\n        border: 1px solid #d5dbdb;\n        border-radius: 4px;\n        padding: 10px 14px;\n        margin: 12px 0;\n        background: #f8f9fa;\n    }\n\n    .info-block table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    .info-block td {\n        padding: 2px 8px;\n        vertical-align: top;\n        font-size: 9pt;\n    }\n\n    .info-block .label {\n        font-weight: 600;\n        color: #1a5276;\n        width: 50%;\n        white-space: nowrap;\n    }\n\n    .info-block .value {\n        font-weight: 400;\n        color: #2c3e50;\n    }\n\n    .info-block .ref-box {\n        text-align: right;\n        font-size: 8pt;\n        color: #7f8c8d;\n        padding-top: 6px;\n        border-top: 1px dashed #d5dbdb;\n        margin-top: 6px;\n    }\n\n    /* ---- Section Titles ---- */\n    .section-title {\n        font-size: 10pt;\n        font-weight: 700;\n        color: #fff;\n        background: #1a5276;\n        padding: 4px 12px;\n        border-radius: 3px;\n        margin: 14px 0 8px 0;\n        text-transform: uppercase;\n        letter-spacing: 0.5px;\n    }\n\n    .section-title .badge {\n        font-size: 8pt;\n        font-weight: 400;\n        background: rgba(255,255,255,0.2);\n        padding: 1px 8px;\n        border-radius: 10px;\n        margin-left: 8px;\n    }\n\n    .sub-section-title {\n        font-size: 9pt;\n        font-weight: 700;\n        color: #1a5276;\n        border-bottom: 1px solid #1a5276;\n        padding: 6px 0 2px 0;\n        margin: 10px 0 6px 0;\n    }\n\n    /* ---- Semester Box ---- */\n    .semester-box {\n        border: 1px solid #d5dbdb;\n        border-radius: 4px;\n        margin: 10px 0;\n        overflow: hidden;\n    }\n\n    .semester-box .sem-header {\n        background: #1a5276;\n        color: #fff;\n        padding: 6px 12px;\n        font-size: 9pt;\n        font-weight: 700;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n    }\n\n    .semester-box .sem-header .sem-stat {\n        font-size: 8pt;\n        font-weight: 400;\n    }\n\n    /* ---- Data Tables ---- */\n    .data-table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 8.5pt;\n    }\n\n    .data-table th {\n        background: #eaf2f8;\n        color: #1a5276;\n        font-weight: 600;\n        padding: 5px 6px;\n        text-align: left;\n        border-bottom: 2px solid #1a5276;\n        font-size: 8pt;\n        text-transform: uppercase;\n        letter-spacing: 0.3px;\n    }\n\n    .data-table td {\n        padding: 4px 6px;\n        border-bottom: 1px solid #eef2f7;\n        vertical-align: middle;\n    }\n\n    .data-table tr:nth-child(even) {\n        background: #fafbfc;\n    }\n\n    .data-table tr:hover {\n        background: #f0f5fa;\n    }\n\n    .data-table .text-center {\n        text-align: center;\n    }\n\n    .data-table .text-right {\n        text-align: right;\n    }\n\n    .data-table .ue-code {\n        font-weight: 600;\n        color: #1a5276;\n        width: 80px;\n    }\n\n    .data-table .ue-name {\n        min-width: 180px;\n    }\n\n    .data-table .grade-badge {\n        display: inline-block;\n        padding: 1px 8px;\n        border-radius: 3px;\n        font-weight: 600;\n        font-size: 8pt;\n    }\n\n    .data-table .grade-valide {\n        background: #d5f5e3;\n        color: #1e8449;\n    }\n\n    .data-table .grade-non-valide {\n        background: #fadbd8;\n        color: #c0392b;\n    }\n\n    .data-table .grade-rattrapage {\n        background: #fdebd0;\n        color: #ca6f1e;\n    }\n\n    /* ---- Recap Row ---- */\n    .recap-row {\n        background: #f0f5fa;\n        border-top: 2px solid #1a5276;\n    }\n\n    .recap-row td {\n        font-weight: 600;\n        padding: 5px 6px;\n    }\n\n    .recap-row .recap-label {\n        color: #1a5276;\n    }\n\n    .recap-row .recap-value {\n        color: #2c3e50;\n    }\n\n    /* ---- Backlog ---- */\n    .backlog-box {\n        background: #fff9f0;\n        border-left: 3px solid #e67e22;\n        padding: 6px 10px;\n        margin: 6px 0;\n        border-radius: 2px;\n    }\n\n    .backlog-box .backlog-title {\n        font-weight: 600;\n        color: #e67e22;\n        font-size: 8pt;\n        text-transform: uppercase;\n        margin-bottom: 4px;\n    }\n\n    /* ---- Bilan Global ---- */\n    .bilan-box {\n        border: 2px solid #1a5276;\n        border-radius: 4px;\n        padding: 10px 14px;\n        margin: 12px 0;\n        background: #f8f9fa;\n    }\n\n    .bilan-box .bilan-title {\n        font-size: 10pt;\n        font-weight: 700;\n        color: #1a5276;\n        text-transform: uppercase;\n        margin-bottom: 8px;\n        text-align: center;\n    }\n\n    .bilan-box table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    .bilan-box td {\n        padding: 4px 10px;\n        font-size: 9pt;\n    }\n\n    .bilan-box .bilan-label {\n        font-weight: 600;\n        color: #34495e;\n        width: 50%;\n    }\n\n    .bilan-box .bilan-value {\n        font-weight: 700;\n        color: #1a5276;\n    }\n\n    .bilan-box .decision-box {\n        text-align: center;\n        margin-top: 8px;\n        padding: 6px;\n        background: #1a5276;\n        color: #fff;\n        font-size: 11pt;\n        font-weight: 800;\n        border-radius: 3px;\n        letter-spacing: 2px;\n        text-transform: uppercase;\n    }\n\n    /* ---- Grade Equivalence Table ---- */\n    .grade-table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 7.5pt;\n        margin: 8px 0;\n    }\n\n    .grade-table th {\n        background: #1a5276;\n        color: #fff;\n        font-weight: 600;\n        padding: 3px 4px;\n        text-align: center;\n        font-size: 7pt;\n        text-transform: uppercase;\n    }\n\n    .grade-table td {\n        padding: 2px 4px;\n        text-align: center;\n        border: 1px solid #d5dbdb;\n    }\n\n    .grade-table .grade-label {\n        font-weight: 700;\n        color: #1a5276;\n    }\n\n    .grade-table .grade-point {\n        font-weight: 400;\n        color: #2c3e50;\n    }\n\n    /* ---- Footer ---- */\n    .footer {\n        margin-top: 20px;\n        border-top: 2px solid #1a5276;\n        padding-top: 10px;\n    }\n\n    .footer .signature-area {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 12px;\n    }\n\n    .footer .signature-area .sig-box {\n        text-align: center;\n        min-width: 150px;\n    }\n\n    .footer .signature-area .sig-box .sig-line {\n        border-top: 1px solid #2c3e50;\n        width: 150px;\n        margin: 30px auto 4px auto;\n    }\n\n    .footer .signature-area .sig-box .sig-label {\n        font-size: 8pt;\n        color: #7f8c8d;\n    }\n\n    .footer .contact-info {\n        font-size: 7.5pt;\n        color: #7f8c8d;\n        text-align: center;\n        padding-top: 6px;\n        border-top: 1px solid #eef2f7;\n    }\n\n    .footer .ref-footer {\n        font-size: 7pt;\n        color: #bdc3c7;\n        text-align: right;\n        margin-top: 4px;\n    }\n\n    /* ---- Page Break ---- */\n    .page-break {\n        page-break-before: always;\n    }\n\n    /* ---- Empty State ---- */\n    .empty-state {\n        text-align: center;\n        padding: 30px;\n        color: #95a5a6;\n        font-size: 10pt;\n    }\n\n    /* ---- Print Adjustments ---- */\n    @media print {\n        .transcript {\n            max-width: 100%;\n        }\n        .data-table tr:nth-child(even) {\n            background: #fafbfc;\n        }\n        .data-table tr:hover {\n            background: none;\n        }\n    }\n</style>\n\n<div class=\"transcript\">\n    {#\n        Document variables (from doc \u2014 Student):\n          doc.name, doc.matricule, doc.nom, doc.prenom,\n          doc.birth_date, doc.birth_place, doc.filiere, doc.niveau_actuel\n\n        Extended data (from get_transcript_data \u2014 available in `data`):\n          data.semesters[]          \u2014 list of semester objects\n          data.grade_scale[]        \u2014 grade equivalence table\n          data.student              \u2014 enriched student info\n          data.school_name          \u2014 from Udshed Setting\n          data.school_logo          \u2014 from Udshed Setting (file URL)\n          data.total_credits        \u2014 sum of all semester credits\n          data.total_credits_obtenus \u2014 validated credits\n          data.pct_validation       \u2014 % of credits validated\n          data.overall_decision     \u2014 final decision\n          data.reference_no         \u2014 document reference\n          data.date_emission        \u2014 issuance date\n          data.filiere_name         \u2014 field of study label\n          data.niveau_label         \u2014 current level label\n          data.cycle                \u2014 Licence / Master\n    #}\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {#  HEADER                         #}\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <div class=\"header\">\n        <div class=\"logo-box\">\n            {% if data.school_logo %}\n                <img src=\"{{ data.school_logo }}\" alt=\"Logo\">\n            {% else %}\n                <div style=\"width:80px;height:80px;background:#eef2f7;border-radius:50%;\"></div>\n            {% endif %}\n        </div>\n\n        <div class=\"title-area\">\n            <div class=\"school-name\">{{ data.school_name or _(\"UNIVERSITY\") }}</div>\n            <div class=\"dept-name\">{{ _(\"Faculty / Institute\") }}</div>\n            <div class=\"doc-title\">{{ _(\"RELEV\u00c9 DE NOTES\") }} / TRANSCRIPT</div>\n        </div>\n\n        <div class=\"logo-box\">\n            <div style=\"width:80px;height:80px;background:#eef2f7;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:7pt;color:#95a5a6;text-align:center;\">\n                {{ _(\"Institut\") }}\n            </div>\n        </div>\n    </div>\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {#  STUDENT INFO BLOCK             #}\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <div class=\"info-block\">\n        <table>\n            <tr>\n                <td class=\"label\">{{ _(\"N\u00b0 Matricule\") }} :</td>\n                <td class=\"value\">{{ data.student.matricule }}</td>\n                <td class=\"label\">{{ _(\"Date de naissance\") }} :</td>\n                <td class=\"value\">\n                    {{ frappe.utils.formatdate(data.student.birth_date, \"dd/mm/yyyy\") if data.student.birth_date else \"\" }}\n                </td>\n            </tr>\n            <tr>\n                <td class=\"label\">{{ _(\"Nom(s) et Pr\u00e9nom(s)\") }} :</td>\n                <td class=\"value\">\n                    {{ data.student.nom.upper() if data.student.nom else \"\" }}\n                    {{ data.student.prenom }}\n                </td>\n                <td class=\"label\">{{ _(\"Dipl\u00f4me pr\u00e9par\u00e9\") }} :</td>\n                <td class=\"value\">{{ data.cycle }}</td>\n            </tr>\n            <tr>\n                <td class=\"label\">{{ _(\"Fili\u00e8re\") }} :</td>\n                <td class=\"value\">{{ data.filiere_name }}</td>\n                <td class=\"label\">{{ _(\"Niveau\") }} :</td>\n                <td class=\"value\">{{ data.niveau_label }}</td>\n            </tr>\n            <tr>\n                <td class=\"label\">{{ _(\"Ann\u00e9e Acad\u00e9mique\") }} :</td>\n                <td class=\"value\" colspan=\"3\">\n                    {% if data.semesters %}\n                        {% set first_year = data.semesters | first %}\n                        {% set last_year = data.semesters | last %}\n                        {{ first_year.academic_year }}\n                        {% if first_year.academic_year != last_year.academic_year %}\n                            \u2014 {{ last_year.academic_year }}\n                        {% endif %}\n                    {% endif %}\n                </td>\n            </tr>\n        </table>\n        <div class=\"ref-box\">\n            <strong>{{ _(\"N\u00b0 R\u00e9f\") }} :</strong> {{ data.reference_no }}\n            &nbsp;|&nbsp;\n            <strong>{{ _(\"Date d'\u00e9mission\") }} :</strong>\n            {{ frappe.utils.formatdate(data.date_emission, \"dd/mm/yyyy\") }}\n        </div>\n    </div>\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {#  PREVIOUS SEMESTER RECAP        #}\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {% if data.semesters and data.semesters | length > 0 and data.prev_credits > 0 %}\n        <div class=\"section-title\">{{ _(\"R\u00e9capitulatif des Semestres Ant\u00e9rieurs\") }}</div>\n        <table class=\"data-table\">\n            <tr class=\"recap-row\">\n                <td class=\"recap-label\" style=\"width:50%;\">{{ _(\"Cr\u00e9dits capitalis\u00e9s\") }} :</td>\n                <td class=\"recap-value\" style=\"width:50%;\">{{ data.prev_credits }}</td>\n            </tr>\n            <tr class=\"recap-row\">\n                <td class=\"recap-label\">{{ _(\"Moyenne Pond\u00e9r\u00e9e Cumul\u00e9e (MPC)\") }} :</td>\n                <td class=\"recap-value\">{{ \"%.2f\" | format(data.prev_mpc) }} / 20</td>\n            </tr>\n        </table>\n    {% endif %}\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {#  PER SEMESTER                   #}\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {% for sem in data.semesters %}\n        <div class=\"semester-box\">\n            <div class=\"sem-header\">\n                <span>\n                    {{ sem.label }} \u2014 {{ sem.academic_year }}\n                    {% if sem.decision %}\n                        <span class=\"sem-stat\">| {{ sem.decision }}</span>\n                    {% endif %}\n                </span>\n                <span class=\"sem-stat\">\n                    {{ _(\"MPS\") }} : {{ \"%.2f\" | format(sem.mps) if sem.mps is not none else \"\u2014\" }}\n                    {% if sem.mpc is not none %}\n                        &nbsp;|&nbsp; {{ _(\"MPC\") }} : {{ \"%.2f\" | format(sem.mpc) }}\n                    {% endif %}\n                </span>\n            </div>\n\n            {# \u2500\u2500 UE Table \u2500\u2500 #}\n            <table class=\"data-table\">\n                <thead>\n                    <tr>\n                        <th style=\"width:80px;\">{{ _(\"Code UE\") }}</th>\n                        <th>{{ _(\"Intitul\u00e9\") }}</th>\n                        <th style=\"width:60px;\" class=\"text-center\">{{ _(\"Cr\u00e9dits\") }}</th>\n                        <th style=\"width:70px;\" class=\"text-center\">{{ _(\"Note /20\") }}</th>\n                        <th style=\"width:70px;\" class=\"text-center\">{{ _(\"Note %\") }}</th>\n                        <th style=\"width:50px;\" class=\"text-center\">{{ _(\"Grade\") }}</th>\n                        <th style=\"width:55px;\" class=\"text-center\">{{ _(\"Point\") }}</th>\n                        <th style=\"width:70px;\" class=\"text-center\">{{ _(\"Session\") }}</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for ue in sem.ues %}\n                    <tr>\n                        <td class=\"ue-code\">{{ ue.code }}</td>\n                        <td class=\"ue-name\">{{ ue.intitule }}</td>\n                        <td class=\"text-center\">{{ ue.credits }}</td>\n                        <td class=\"text-center\">{{ \"%.2f\" | format(ue.note_finale) if ue.note_finale is not none else \"\u2014\" }}</td>\n                        <td class=\"text-center\">\n                            {% if ue.note_pct is not none %}\n                                <span class=\"grade-badge {{ 'grade-valide' if ue.statut == 'Valid\u00e9' else 'grade-non-valide' }}\">\n                                    {{ \"%.2f\" | format(ue.note_pct) }}%\n                                </span>\n                            {% else %}\n                                \u2014\n                            {% endif %}\n                        </td>\n                        <td class=\"text-center\">\n                            <strong>{{ ue.grade }}</strong>\n                        </td>\n                        <td class=\"text-center\">{{ \"%.2f\" | format(ue.point) if ue.point is not none else \"\u2014\" }}</td>\n                        <td class=\"text-center\">\n                            {% if ue.est_rattrapage %}\n                                <span class=\"grade-badge grade-rattrapage\">{{ ue.session }}</span>\n                            {% else %}\n                                {{ ue.session }}\n                            {% endif %}\n                        </td>\n                    </tr>\n                    {% else %}\n                    <tr>\n                        <td colspan=\"8\" class=\"empty-state\">{{ _(\"Aucune unit\u00e9 d'enseignement enregistr\u00e9e.\") }}</td>\n                    </tr>\n                    {% endfor %}\n                </tbody>\n            </table>\n\n            {# \u2500\u2500 Backlogs \u2500\u2500 #}\n            {% if sem.backlogs and sem.backlogs | length > 0 %}\n            <div class=\"backlog-box\">\n                <div class=\"backlog-title\">\n                    {{ _(\"Unit\u00e9s d'enseignement reprises / Backlogs\") }}\n                    ({{ sem.backlogs | length }})\n                </div>\n                <table class=\"data-table\">\n                    <tr>\n                        <th style=\"width:80px;\">{{ _(\"Code\") }}</th>\n                        <th>{{ _(\"Intitul\u00e9\") }}</th>\n                        <th style=\"width:50px;\" class=\"text-center\">{{ _(\"Cr\u00e9dits\") }}</th>\n                        <th style=\"width:70px;\" class=\"text-center\">{{ _(\"Note %\") }}</th>\n                        <th style=\"width:50px;\" class=\"text-center\">{{ _(\"Grade\") }}</th>\n                    </tr>\n                    {% for bklg in sem.backlogs %}\n                    <tr>\n                        <td class=\"ue-code\">{{ bklg.code }}</td>\n                        <td>{{ bklg.intitule }}</td>\n                        <td class=\"text-center\">{{ bklg.credits }}</td>\n                        <td class=\"text-center\">\n                            <span class=\"grade-badge grade-non-valide\">\n                                {{ \"%.2f\" | format(bklg.note_pct) if bklg.note_pct is not none else \"\u2014\" }}%\n                            </span>\n                        </td>\n                        <td class=\"text-center\">{{ bklg.grade }}</td>\n                    </tr>\n                    {% endfor %}\n                </table>\n            </div>\n            {% endif %}\n\n            {# \u2500\u2500 Semester Recap \u2500\u2500 #}\n            <table class=\"data-table\">\n                <tr class=\"recap-row\">\n                    <td class=\"recap-label\" style=\"width:25%;\">{{ _(\"Cr\u00e9dits inscrits\") }} :</td>\n                    <td class=\"recap-value\" style=\"width:25%;\">{{ sem.total_credits or 0 }}</td>\n                    <td class=\"recap-label\" style=\"width:25%;\">{{ _(\"MPS\") }} :</td>\n                    <td class=\"recap-value\" style=\"width:25%;\">\n                        {{ \"%.2f\" | format(sem.mps) if sem.mps is not none else \"\u2014\" }} / 20\n                    </td>\n                </tr>\n                <tr class=\"recap-row\">\n                    <td class=\"recap-label\">{{ _(\"Cr\u00e9dits valid\u00e9s\") }} :</td>\n                    <td class=\"recap-value\">{{ sem.credits_obtenus or 0 }}</td>\n                    <td class=\"recap-label\">{{ _(\"MPC\") }} :</td>\n                    <td class=\"recap-value\">\n                        {{ \"%.2f\" | format(sem.mpc) if sem.mpc is not none else \"\u2014\" }} / 20\n                    </td>\n                </tr>\n                {% if sem.mention %}\n                <tr class=\"recap-row\">\n                    <td class=\"recap-label\">{{ _(\"Mention\") }} :</td>\n                    <td class=\"recap-value\">{{ sem.mention }}</td>\n                    <td colspan=\"2\"></td>\n                </tr>\n                {% endif %}\n            </table>\n        </div>\n    {% else %}\n        <div class=\"empty-state\">\n            <p>{{ _(\"Aucun r\u00e9sultat de semestre disponible pour cet \u00e9tudiant.\") }}</p>\n        </div>\n    {% endfor %}\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {#  BILAN GLOBAL                   #}\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {% if data.semesters and data.semesters | length > 0 %}\n    <div class=\"bilan-box\">\n        <div class=\"bilan-title\">{{ _(\"Bilan Global\") }}</div>\n\n        <table>\n            <tr>\n                <td class=\"bilan-label\">{{ _(\"Total des cr\u00e9dits inscrits\") }} :</td>\n                <td class=\"bilan-value text-center\">{{ data.total_credits }}</td>\n                <td class=\"bilan-label\">{{ _(\"Total des cr\u00e9dits valid\u00e9s\") }} :</td>\n                <td class=\"bilan-value text-center\">{{ data.total_credits_obtenus }}</td>\n            </tr>\n            <tr>\n                <td class=\"bilan-label\">{{ _(\"Pourcentage de validation\") }} :</td>\n                <td class=\"bilan-value text-center\">{{ \"%.2f\" | format(data.pct_validation) }}%</td>\n                <td class=\"bilan-label\">{{ _(\"MPC Globale\") }} :</td>\n                <td class=\"bilan-value text-center\">\n                    {{ \"%.2f\" | format(data.semesters[-1].mpc) if data.semesters[-1].mpc is not none else \"\u2014\" }} / 20\n                </td>\n            </tr>\n        </table>\n\n        <div class=\"decision-box\">\n            {% if data.overall_decision == \"Admis\" %}\n                {{ _(\"ADMIS\") }}\n            {% elif data.overall_decision == \"Ajourn\u00e9\" %}\n                {{ _(\"AJOURN\u00c9\") }}\n            {% elif data.overall_decision == \"En attente\" %}\n                {{ _(\"EN ATTENTE\") }}\n            {% else %}\n                {{ data.overall_decision }}\n            {% endif %}\n        </div>\n    </div>\n    {% endif %}\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {#  GRADE EQUIVALENCE TABLE        #}\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <div class=\"sub-section-title\">{{ _(\"Tableau d'\u00e9quivalence des grades\") }}</div>\n\n    {% if data.grade_scale and data.grade_scale | length > 0 %}\n    <table class=\"grade-table\">\n        <thead>\n            <tr>\n                <th>{{ _(\"Grade\") }}</th>\n                {% for g in data.grade_scale %}\n                    <th>{{ g.grade }}</th>\n                {% endfor %}\n            </tr>\n        </thead>\n        <tbody>\n            <tr>\n                <td style=\"background:#eaf2f8;font-weight:600;\">{{ _(\"Points\") }}</td>\n                {% for g in data.grade_scale %}\n                    <td>{{ \"%.2f\" | format(g.point) }}</td>\n                {% endfor %}\n            </tr>\n            <tr>\n                <td style=\"background:#eaf2f8;font-weight:600;\">{{ _(\"Note %\") }}</td>\n                {% for g in data.grade_scale %}\n                    <td>{{ \"%.0f\" | format(g.note_min) }}\u2013{{ \"%.0f\" | format(g.note_max) }}</td>\n                {% endfor %}\n            </tr>\n            {% if data.grade_scale | selectattr(\"mention\") | first %}\n            <tr>\n                <td style=\"background:#eaf2f8;font-weight:600;\">{{ _(\"Mention\") }}</td>\n                {% for g in data.grade_scale %}\n                    <td style=\"font-size:6.5pt;\">{{ g.mention }}</td>\n                {% endfor %}\n            </tr>\n            {% endif %}\n        </tbody>\n    </table>\n    {% else %}\n        <p style=\"color:#95a5a6;font-size:8pt;text-align:center;\">\n            {{ _(\"Aucune grille de grades configur\u00e9e.\") }}\n        </p>\n    {% endif %}\n\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    {#  FOOTER \u2014 SIGNATURE             #}\n    {# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 #}\n    <div class=\"footer\">\n        <div class=\"signature-area\">\n            <div class=\"sig-box\">\n                <div class=\"sig-line\"></div>\n                <div class=\"sig-label\">{{ _(\"Le Chef d'\u00c9tablissement\") }}</div>\n            </div>\n            <div class=\"sig-box\">\n                <div class=\"sig-line\"></div>\n                <div class=\"sig-label\">{{ _(\"Cachet & Date\") }}</div>\n            </div>\n            <div class=\"sig-box\">\n                <div class=\"sig-line\"></div>\n                <div class=\"sig-label\">{{ _(\"Le Responsable P\u00e9dagogique\") }}</div>\n            </div>\n        </div>\n\n        <div class=\"contact-info\">\n            {{ data.school_name or \"UNIVERSITY\" }} \u2014\n            {{ _(\"BP\") }} : _________ \u2014\n            {{ _(\"T\u00e9l\") }} : (+237) ___ ___ ___ \u2014\n            {{ _(\"Email\") }} : contact@university.cm\n        </div>\n\n        <div class=\"ref-footer\">\n            {{ _(\"Document g\u00e9n\u00e9r\u00e9 le\") }}\n            {{ frappe.utils.formatdate(data.date_emission, \"dd/mm/yyyy\") }}\n            \u2014 {{ _(\"R\u00e9f\") }} : {{ data.reference_no }}\n        </div>\n    </div>\n</div>\n",
